# Copy to .env and fill in your own key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model used for detection and /ask (default: openai/gpt-oss-120b).
# If Groq retires a model, uploads return HTTP 502 naming the model; set a current one here.
# GROQ_MODEL=openai/gpt-oss-120b
